{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ops/database-backup/Dockerfile"
  },
  "deploy": {
    "preDeployCommand": [],
    "startCommand": "node /app/database-backup.mjs backup",
    "cronSchedule": "0 8 * * *",
    "restartPolicyType": "NEVER"
  }
}
