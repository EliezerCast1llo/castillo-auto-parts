DATABASE_URL="postgresql://postgres:postgres@localhost:5432/castillo_auto_parts"

NEXT_PUBLIC_APP_NAME="Castillo Auto Parts"
NEXT_PUBLIC_DEFAULT_LOCALE="es"
# Google Maps — clave pública (NEXT_PUBLIC_) visible en el bundle del navegador.
# OBLIGATORIO antes de producción: restringir en Google Cloud Console:
#   APIs & Services → Credentials → seleccionar la clave → Application restrictions
#   → "HTTP referrers (websites)" → añadir tu dominio (ej: https://tudominio.com/*)
# Además, en "API restrictions" habilitar solo Maps JavaScript API y/o Places API.
# Una clave sin restricciones puede ser usada por terceros y generar cargos inesperados.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

PAYMENT_PROVIDER="mock"
# Wompi El Salvador. PAYMENT_PROVIDER="wompi" solo cuando estas variables
# estén configuradas. El API Secret del aplicativo se usa para OAuth; Wompi
# también lo usa como llave HMAC del webhook.
WOMPI_APP_ID=""
WOMPI_API_SECRET=""
WOMPI_WEBHOOK_SECRET="" # Debe corresponder al API Secret configurado en Wompi.
WOMPI_WEBHOOK_URL="" # Ejemplo: https://tudominio.com/api/webhooks/wompi
WOMPI_ENVIRONMENT="sandbox" # sandbox | production
WOMPI_API_BASE_URL="https://api.wompi.sv"
WOMPI_IDENTITY_BASE_URL="https://id.wompi.sv"
# Protege /api/internal/expire-payment-reservations. Configurar el mismo valor
# como Bearer token en el scheduler que invoque el endpoint cada 5 minutos.
RESERVATION_CRON_SECRET="replace-with-a-32-plus-character-random-secret"

DTE_MODE="manual"

EMAIL_PROVIDER="console"
# En producción usar: EMAIL_PROVIDER="resend"
EMAIL_FROM="Castillo Auto Parts <no-reply@castilloautoparts.local>"

# Resend — proveedor de email para producción.
# Crear cuenta en https://resend.com → API Keys.
RESEND_API_KEY=""

# Auth.js v5 — autenticación de clientes.
# NEXTAUTH_SECRET: string aleatorio de ≥32 chars (openssl rand -base64 32)
# NEXTAUTH_URL: URL pública de la app (en Vercel se auto-detecta)
NEXTAUTH_SECRET="replace-with-a-32-plus-character-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — crear credenciales en console.cloud.google.com
# APIs & Services → Credentials → Create OAuth 2.0 Client ID
# Authorized redirect URIs: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Secreto para firmar tokens de sesión admin (HMAC-SHA256).
# En producción: string aleatorio de ≥32 caracteres.
ADMIN_ACCESS_SECRET="replace-with-a-32-plus-character-random-secret"

# Seed del primer usuario administrador.
# Solo se usa al correr `npx prisma db seed` o `npm run db:seed`.
# En producción: usa credenciales seguras y elimina estas líneas tras el primer setup.
ADMIN_SEED_EMAIL="admin@tudominio.com"
ADMIN_SEED_PASSWORD="replace-with-a-strong-password"
GUEST_CART_SECRET="replace-with-a-32-plus-character-random-secret"

# Rate limiter Redis (Upstash) — opcional.
# Si no se configuran, el rate limiter usa memoria en proceso (válido para un
# solo servidor). En producción serverless multi-instancia se recomienda Redis.
# Crear cuenta gratuita en https://upstash.com → Redis → REST API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 — almacenamiento de imágenes de producto.
# Crear bucket en dash.cloudflare.com → R2 Object Storage.
# Habilitar acceso público en Settings → Public access para obtener CLOUDFLARE_R2_PUBLIC_URL.
# Crear API Token en R2 → Manage R2 API Tokens → Create Account API Token.
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_PUBLIC_URL=""
