generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SALES
  WAREHOUSE
  SUPPORT
  ACCOUNTING
  MARKETING
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PREORDER
}

enum OrderStatus {
  PAYMENT_PROCESSING
  PAID_PENDING_SHIPMENT
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum InvoiceStatus {
  PENDING
  PENDING_MANUAL
  ISSUED
  FAILED
  VOIDED
  MANUAL_REVIEW
}

model User {
  id            String    @id @default(cuid())
  /// Idioma preferido para los correos que no nacen de un request suyo.
  locale        String    @default("es")
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          UserRole  @default(CUSTOMER)
  passwordHash  String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  carts         Cart[]
  addresses     Address[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GuestSession {
  id               String   @id @default(cuid())
  sessionTokenHash String   @unique
  email            String?
  phone            String?
  expiresAt        DateTime
  cart             Cart?
  orders           Order[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProductCategory {
  id           String                       @id @default(cuid())
  name         String
  slug         String                       @unique
  description  String?
  isActive     Boolean                      @default(true)
  sortOrder    Int                          @default(0)
  products     Product[]
  translations ProductCategoryTranslation[]
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
}

model Product {
  id                 String                 @id @default(cuid())
  name               String
  slug               String                 @unique
  brand              String
  sku                String                 @unique
  partNumber         String?
  shortDescription   String?
  description        String?
  technicalDetails   Json?
  categoryId         String
  category           ProductCategory        @relation(fields: [categoryId], references: [id])
  priceCents         Int
  currency           String                 @default("USD")
  ivaRate            Decimal                @default(0.13)
  isActive           Boolean                @default(true)
  isFeatured         Boolean                @default(false)
  images             ProductImage[]
  compatibilities    VehicleCompatibility[]
  inventoryStocks    InventoryStock[]
  stockAlertRequests StockAlertRequest[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  translations       ProductTranslation[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([categoryId])
  @@index([brand])
  @@index([isActive, isFeatured])
  @@index([isActive, brand])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  url       String
  alt       String
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
}

model VehicleCompatibility {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  make      String
  model     String
  yearFrom  Int
  yearTo    Int

  @@index([productId])
  @@index([make, model, yearFrom, yearTo])
}

model InventoryLocation {
  id                 String           @id @default(cuid())
  name               String
  code               String           @unique
  address            String?
  pickupHours        String?
  pickupInstructions String?
  latitude           Decimal?
  longitude          Decimal?
  isDefault          Boolean          @default(false)
  isActive           Boolean          @default(true)
  stocks             InventoryStock[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model InventoryStock {
  id               String            @id @default(cuid())
  productId        String
  product          Product           @relation(fields: [productId], references: [id])
  locationId       String
  location         InventoryLocation @relation(fields: [locationId], references: [id])
  quantityOnHand   Int               @default(0)
  quantityReserved Int               @default(0)
  reorderPoint     Int               @default(0)
  status           InventoryStatus   @default(OUT_OF_STOCK)
  updatedAt        DateTime          @updatedAt

  @@unique([productId, locationId])
}

model Cart {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  guestSessionId String?       @unique
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id])
  items          CartItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model CartItem {
  id                 String   @id @default(cuid())
  cartId             String
  cart               Cart     @relation(fields: [cartId], references: [id])
  productId          String
  product            Product  @relation(fields: [productId], references: [id])
  quantity           Int
  priceSnapshotCents Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

model Address {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  formattedAddress String
  addressLine1     String
  addressLine2     String?
  city             String
  department       String
  country          String   @default("SV")
  postalCode       String?
  placeId          String?
  latitude         Decimal?
  longitude        Decimal?
  deliveryNotes    String?
  orders           Order[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Order {
  id                   String        @id @default(cuid())
  /// Idioma en el que el cliente hizo la compra. El correo de confirmacion se
  /// dispara desde el webhook del proveedor de pagos, fuera de todo request con
  /// segmento de idioma: sin esta columna no hay forma de saberlo. Y el checkout
  /// admite invitados, asi que `User` no alcanza.
  locale               String        @default("es")
  orderNumber          String        @unique
  idempotencyKey       String?       @unique
  intentHash           String?
  accessTokenHash      String?
  emailAccessTokenHash String?
  userId               String?
  user                 User?         @relation(fields: [userId], references: [id])
  guestSessionId       String?
  guestSession         GuestSession? @relation(fields: [guestSessionId], references: [id])
  customerName         String
  customerEmail        String
  customerPhone        String
  status               OrderStatus   @default(PAYMENT_PROCESSING)
  subtotalCents        Int
  taxCents             Int
  shippingCents        Int           @default(0)
  totalCents           Int
  currency             String        @default("USD")
  addressId            String?
  address              Address?      @relation(fields: [addressId], references: [id])
  notes                String?
  paidAt               DateTime?
  reservationExpiresAt DateTime?
  items                OrderItem[]
  payment              Payment?
  invoice              InvoiceDte?
  shipment             Shipment?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([status])
  @@index([status, reservationExpiresAt])
  @@index([customerEmail])
  @@index([accessTokenHash])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  order               Order   @relation(fields: [orderId], references: [id])
  productId           String
  product             Product @relation(fields: [productId], references: [id])
  productNameSnapshot String
  skuSnapshot         String
  partNumberSnapshot  String?
  brandSnapshot       String
  unitPriceCents      Int
  quantity            Int
  taxCents            Int
  lineTotalCents      Int

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String         @id @default(cuid())
  orderId           String         @unique
  order             Order          @relation(fields: [orderId], references: [id])
  provider          String
  status            PaymentStatus  @default(PENDING)
  amountCents       Int
  currency          String         @default("USD")
  externalPaymentId String?
  externalReference String?
  checkoutUrl       String?
  rawStatus         String?
  paidAt            DateTime?
  events            PaymentEvent[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([provider, externalPaymentId])
  @@index([externalPaymentId])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id])
  provider        String
  eventType       String
  externalEventId String?
  payloadJson     Json
  receivedAt      DateTime @default(now())
  isValid         Boolean  @default(false)

  @@unique([provider, externalEventId])
}

model InvoiceDte {
  id               String        @id @default(cuid())
  orderId          String        @unique
  order            Order         @relation(fields: [orderId], references: [id])
  status           InvoiceStatus @default(PENDING_MANUAL)
  documentType     String?
  generationCode   String?
  controlNumber    String?
  receptionSeal    String?
  issuedAt         DateTime?
  receiverName     String?
  receiverDocument String?
  receiverEmail    String?
  jsonUrl          String?
  pdfUrl           String?
  errorMessage     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Shipment {
  id                  String    @id @default(cuid())
  orderId             String    @unique
  order               Order     @relation(fields: [orderId], references: [id])
  method              String
  status              String    @default("PENDING")
  deliveryZone        String?
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?
  notes               String?
}

model DeliveryZone {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  city       String
  department String
  feeCents   Int
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([city, department])
}

model AdminAuditLog {
  id             String   @id @default(cuid())
  action         String
  entityType     String
  entityId       String?
  entityLabel    String?
  metadata       Json?
  adminUserId    String?
  adminUserEmail String?
  createdAt      DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([adminUserId])
}

model EmailLog {
  id           String    @id @default(cuid())
  recipient    String
  subject      String
  template     String
  status       String
  provider     String
  externalId   String?
  errorMessage String?
  payloadJson  Json?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([recipient])
  @@index([status])
  @@index([template])
}

model StockAlertRequest {
  id                  String   @id @default(cuid())
  productId           String?
  product             Product? @relation(fields: [productId], references: [id])
  skuSnapshot         String
  productNameSnapshot String
  email               String?
  phone               String?
  requestedQuantity   Int      @default(1)
  status              String   @default("OPEN")
  source              String   @default("cart")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([email])
  @@index([productId])
  @@index([skuSnapshot])
  @@index([status])
}

/// Traduccion de un producto a un idioma no principal.
///
/// El espanol vive en las columnas de `Product`: aca solo hay filas para los
/// demas idiomas. Cada campo es nullable a proposito, para que el fallback sea
/// **por campo** y no por fila: un producto con nombre en ingles pero sin
/// descripcion muestra el nombre traducido y la descripcion en espanol.
/// Traducción de un producto. Los campos son nullable a propósito: el fallback
/// es por campo, así que un producto con `name` en inglés y sin `description`
/// muestra el nombre traducido y la descripción en español.
///
/// `locale` tiene un CHECK de formato (`^[a-z]{2}$`) que Prisma no puede
/// expresar; vive en la migración 20260820120000_locale_format_check.
model ProductTranslation {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale           String
  name             String?
  shortDescription String?
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([productId, locale])
  @@index([locale])
}

/// Traduccion de una categoria. Mismas reglas que ProductTranslation.
/// Ver la nota de ProductTranslation: mismo criterio de nullabilidad y mismo
/// CHECK de formato sobre `locale`.
model ProductCategoryTranslation {
  id          String          @id @default(cuid())
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      String
  name        String?
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([categoryId, locale])
  @@index([locale])
}
